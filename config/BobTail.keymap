#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    // JIS symbols are named macros so Keymap Editor can select them.
    // Each macro holds its key until physical release (including OS repeat).

    macros {
        jp_excl: JIS_EXCL {
            compatible = "zmk,behavior-macro";
            label = "JIS !";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N1)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N1)>;
        };

        jp_dqt: JIS_DQT {
            compatible = "zmk,behavior-macro";
            label = "JIS Double Quote";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N2)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N2)>;
        };

        jp_hash: JIS_HASH {
            compatible = "zmk,behavior-macro";
            label = "JIS #";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N3)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N3)>;
        };

        jp_dllr: JIS_DLLR {
            compatible = "zmk,behavior-macro";
            label = "JIS $";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N4)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N4)>;
        };

        jp_prcnt: JIS_PRCNT {
            compatible = "zmk,behavior-macro";
            label = "JIS %";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N5)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N5)>;
        };

        jp_amps: JIS_AMPS {
            compatible = "zmk,behavior-macro";
            label = "JIS &";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N6)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N6)>;
        };

        jp_sqt: JIS_SQT {
            compatible = "zmk,behavior-macro";
            label = "JIS '";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N7)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N7)>;
        };

        jp_lpar: JIS_LPAR {
            compatible = "zmk,behavior-macro";
            label = "JIS (";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N8)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N8)>;
        };

        jp_rpar: JIS_RPAR {
            compatible = "zmk,behavior-macro";
            label = "JIS )";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N9)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N9)>;
        };

        jp_astrk: JIS_ASTRK {
            compatible = "zmk,behavior-macro";
            label = "JIS *";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(SINGLE_QUOTE)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(SINGLE_QUOTE)>;
        };

        jp_plus: JIS_PLUS {
            compatible = "zmk,behavior-macro";
            label = "JIS +";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(SEMICOLON)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(SEMICOLON)>;
        };

        jp_comma: JIS_COMMA {
            compatible = "zmk,behavior-macro";
            label = "JIS ,";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp COMMA>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp COMMA>;
        };

        jp_minus: JIS_MINUS {
            compatible = "zmk,behavior-macro";
            label = "JIS -";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp MINUS>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp MINUS>;
        };

        jp_dot: JIS_DOT {
            compatible = "zmk,behavior-macro";
            label = "JIS .";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp DOT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp DOT>;
        };

        jp_slash: JIS_SLASH {
            compatible = "zmk,behavior-macro";
            label = "JIS /";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp SLASH>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SLASH>;
        };

        jp_colon: JIS_COLON {
            compatible = "zmk,behavior-macro";
            label = "JIS :";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp SINGLE_QUOTE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SINGLE_QUOTE>;
        };

        jp_semi: JIS_SEMI {
            compatible = "zmk,behavior-macro";
            label = "JIS ;";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp SEMICOLON>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SEMICOLON>;
        };

        jp_lt: JIS_LT {
            compatible = "zmk,behavior-macro";
            label = "JIS <";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(COMMA)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(COMMA)>;
        };

        jp_equal: JIS_EQUAL {
            compatible = "zmk,behavior-macro";
            label = "JIS =";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(MINUS)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(MINUS)>;
        };

        jp_gt: JIS_GT {
            compatible = "zmk,behavior-macro";
            label = "JIS >";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(DOT)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(DOT)>;
        };

        jp_qmark: JIS_QMARK {
            compatible = "zmk,behavior-macro";
            label = "JIS ?";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(SLASH)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(SLASH)>;
        };

        jp_at: JIS_AT {
            compatible = "zmk,behavior-macro";
            label = "JIS @";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_BRACKET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_BRACKET>;
        };

        jp_lbkt: JIS_LBKT {
            compatible = "zmk,behavior-macro";
            label = "JIS [";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_BRACKET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp RIGHT_BRACKET>;
        };

        jp_bslh: JIS_BSLH {
            compatible = "zmk,behavior-macro";
            label = "JIS Backslash";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp INT1>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT1>;
        };

        jp_rbkt: JIS_RBKT {
            compatible = "zmk,behavior-macro";
            label = "JIS ]";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp NON_US_HASH>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp NON_US_HASH>;
        };

        jp_caret: JIS_CARET {
            compatible = "zmk,behavior-macro";
            label = "JIS ^";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp EQUAL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp EQUAL>;
        };

        jp_under: JIS_UNDER {
            compatible = "zmk,behavior-macro";
            label = "JIS _";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(INT1)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(INT1)>;
        };

        jp_grave: JIS_GRAVE {
            compatible = "zmk,behavior-macro";
            label = "JIS `";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(LEFT_BRACKET)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(LEFT_BRACKET)>;
        };

        jp_lbrc: JIS_LBRC {
            compatible = "zmk,behavior-macro";
            label = "JIS {";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(RIGHT_BRACKET)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(RIGHT_BRACKET)>;
        };

        jp_pipe: JIS_PIPE {
            compatible = "zmk,behavior-macro";
            label = "JIS |";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(INT3)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(INT3)>;
        };

        jp_rbrc: JIS_RBRC {
            compatible = "zmk,behavior-macro";
            label = "JIS }";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(NON_US_HASH)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(NON_US_HASH)>;
        };

        jp_tilde: JIS_TILDE {
            compatible = "zmk,behavior-macro";
            label = "JIS ~";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(EQUAL)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(EQUAL)>;
        };

        jp_yen: JIS_YEN {
            compatible = "zmk,behavior-macro";
            label = "JIS Yen";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp INT3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT3>;
        };

        jp_henkan: JIS_HENKAN {
            compatible = "zmk,behavior-macro";
            label = "JIS Henkan";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp INT4>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT4>;
        };

        jp_muhenkan: JIS_MUHENKAN {
            compatible = "zmk,behavior-macro";
            label = "JIS Muhenkan";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp INT5>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT5>;
        };

        jp_kana: JIS_KANA {
            compatible = "zmk,behavior-macro";
            label = "JIS Kana";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp INT2>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp INT2>;
        };

        jp_zkhk: JIS_ZKHK {
            compatible = "zmk,behavior-macro";
            label = "JIS Zenkaku/Hankaku";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp GRAVE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp GRAVE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        lang {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W       &kp E         &kp R         &kp T                                                    &kp Y        &kp U  &kp I      &kp O      &kp P
&mt LEFT_WIN A      &kp S       &kp D         &lt 4 F       &kp G        &kp LC(Y)              &kp PRINTSCREEN      &kp H        &kp J  &lt 5 K    &kp L      &jp_semi
&mt LEFT_CONTROL Z  &kp X       &kp C         &kp V         &kp B        &kp LC(Z)              &kp ESC              &kp N        &kp M  &mkp LCLK  &mkp RCLK  &jp_slash
&kp TAB             &kp C_MUTE  &kp LEFT_GUI  &kp LEFT_ALT  &lt 2 SPACE  &mt LSHIFT DELETE      &mt RSHFT BACKSPACE  &lt 1 ENTER                               &kp F4
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        FUNCTION {
            bindings = <
&kp N1    &kp N2     &kp N3     &kp N4     &kp N5                              &kp N6     &kp N7    &kp N8    &kp N9        &kp N0
&jp_plus  &jp_minus  &jp_astrk  &jp_slash  &jp_equal  &jp_under      &kp HOME  &kp ENTER  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT
&kp F1    &kp F2     &kp F3     &kp F4     &kp F5     &trans         &trans    &kp F6     &kp F7    &kp F8    &kp F9        &kp F10
&trans    &trans     &trans     &trans     &trans     &trans         &trans    &trans                                       &kp F11
            >;
        };

        NUM {
            bindings = <
&jp_excl      &jp_at        &jp_hash      &jp_dllr      &jp_prcnt                         &jp_caret  &jp_amps  &jp_under  &jp_tilde  &jp_minus
&jp_sqt       &jp_lbrc      &jp_lbkt      &jp_lpar      &jp_dqt       &jp_lt      &jp_gt  &jp_dqt    &jp_rpar  &jp_rbkt   &jp_rbrc   &jp_sqt
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans     &trans    &trans     &jp_pipe   &jp_bslh
&bt BT_CLR    &trans        &trans        &trans        &trans        &trans      &trans  &trans                                     &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
