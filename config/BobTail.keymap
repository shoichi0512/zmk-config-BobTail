        jp_rbrc: JIS_RBRC {
            compatible = "zmk,behavior-macro";
            label = "JIS }";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(NON_US_HASH)>,
                <&macro_pause_for_release>,
