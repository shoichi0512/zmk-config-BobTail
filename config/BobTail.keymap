                <&kp NON_US_HASH>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp NON_US_HASH>;
        };

        jp_caret: JIS_CARET {
            compatible = "zmk,behavior-macro";
            label = "JIS ^";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp EQUAL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp EQUAL>;
        };

        jp_under: JIS_UNDER {
            compatible = "zmk,behavior-macro";
            label = "JIS _";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(INT1)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(INT1)>;
        };

        jp_grave: JIS_GRAVE {
            compatible = "zmk,behavior-macro";
            label = "JIS `";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(LEFT_BRACKET)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(LEFT_BRACKET)>;
        };

        jp_lbrc: JIS_LBRC {
            compatible = "zmk,behavior-macro";
            label = "JIS {";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(RIGHT_BRACKET)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(RIGHT_BRACKET)>;
        };

        jp_pipe: JIS_PIPE {
            compatible = "zmk,behavior-macro";
            label = "JIS |";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(INT3)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(INT3)>;
