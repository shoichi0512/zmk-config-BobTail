#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    // Thumb Shift keys: prefer holding when another key is pressed.

    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

/ {
    // JIS symbols are named macros so Keymap Editor can select them.
    // Each macro holds its key until physical release (including OS repeat).

    macros {
        device_status: device_status {
            compatible = "zmk,behavior-macro";
            label = "Device Status Text";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&device_diagnostics 0>;
        };

        bluetooth_repair: bluetooth_repair {
            compatible = "zmk,behavior-macro";
            label = "Re-pair Selected Bluetooth Slot";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&device_diagnostics 2>;
        };

        scroll_faster: scroll_faster {
            compatible = "zmk,behavior-macro";
            label = "Ball Scroll Faster";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&scroll_speed 1>;
        };

        scroll_slower: scroll_slower {
            compatible = "zmk,behavior-macro";
            label = "Ball Scroll Slower";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&scroll_speed 0>;
        };

        jp_excl: JIS_EXCL {
            compatible = "zmk,behavior-macro";
            label = "JIS !";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(N1)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(N1)>;
