                <&macro_release>,
                <&kp LS(MINUS)>;
        };

        jp_gt: JIS_GT {
            compatible = "zmk,behavior-macro";
            label = "JIS >";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(DOT)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(DOT)>;
        };

        jp_qmark: JIS_QMARK {
            compatible = "zmk,behavior-macro";
            label = "JIS ?";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(SLASH)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(SLASH)>;
        };

        jp_at: JIS_AT {
            compatible = "zmk,behavior-macro";
            label = "JIS @";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_BRACKET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_BRACKET>;
        };

        jp_lbkt: JIS_LBKT {
            compatible = "zmk,behavior-macro";
            label = "JIS [";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_BRACKET>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp RIGHT_BRACKET>;
        };

        jp_bslh: JIS_BSLH {
            compatible = "zmk,behavior-macro";
            label = "JIS Backslash";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
