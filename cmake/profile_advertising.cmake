# Keep ZMK's advertising state machine authoritative. Build a checked copy of
# its source with two small hooks; never edit the dependency checkout in place.
function(bobtail_replace_once variable needle replacement)
  string(FIND "${${variable}}" "${needle}" first)
  if(first LESS 0)
    message(FATAL_ERROR "BobTail BLE policy: expected ZMK source hook was not found")
  endif()
  string(LENGTH "${needle}" needle_length)
  math(EXPR after "${first} + ${needle_length}")
  string(SUBSTRING "${${variable}}" ${after} -1 remainder)
  string(FIND "${remainder}" "${needle}" duplicate)
  if(NOT duplicate LESS 0)
    message(FATAL_ERROR "BobTail BLE policy: ambiguous ZMK source hook")
  endif()
  string(REPLACE "${needle}" "${replacement}" modified "${${variable}}")
  set(${variable} "${modified}" PARENT_SCOPE)
endfunction()

function(bobtail_apply_profile_advertising_policy)
  set(upstream "${APPLICATION_SOURCE_DIR}/src/ble.c")
  file(READ "${upstream}" ble_source)
  set(advertising_log "    LOG_DBG(\"advertising from %d to %d\", advertising_status, desired_adv);")
  bobtail_replace_once(ble_source "${advertising_log}"
    "    if (!bobtail_profile_advertising_allowed()) { desired_adv = ZMK_ADV_NONE; }\n${advertising_log}")
  bobtail_replace_once(ble_source
    "bt_le_adv_start(ZMK_ADV_CONN_NAME, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad), NULL, 0)"
    "bobtail_profile_start_advertising(ZMK_ADV_CONN_NAME, zmk_ble_ad, ARRAY_SIZE(zmk_ble_ad))")

  set(patched "${PROJECT_BINARY_DIR}/bobtail_ble.c")
  file(WRITE "${patched}" "#include <bobtail/profile_connection.h>\n${ble_source}\nint bobtail_profile_refresh_advertising(void) {\n    int err = 0;\n    if (advertising_status != ZMK_ADV_NONE) { CHECKED_ADV_STOP(); }\n    return update_advertising();\n}\n")
  get_target_property(app_sources app SOURCES)
  set(remaining_sources)
  set(replaced 0)
  foreach(source IN LISTS app_sources)
    if(source STREQUAL "src/ble.c" OR source STREQUAL "${upstream}")
      math(EXPR replaced "${replaced} + 1")
    else()
      list(APPEND remaining_sources "${source}")
    endif()
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "BobTail BLE policy: expected exactly one ZMK ble.c source, found ${replaced}")
  endif()
  set_property(TARGET app PROPERTY SOURCES "${remaining_sources}")
  target_sources(app PRIVATE "${patched}")
  target_include_directories(app PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}")
  message(STATUS "BobTail: applying profile advertising policy to ZMK ble.c")
endfunction()
